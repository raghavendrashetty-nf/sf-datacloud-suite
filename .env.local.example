# Copy this file to .env.local (already gitignored) and fill in what you need.
# Used by the Solution Recommender's SOW analysis.

# Production (e.g. Railway) - free Gemini API tier, works anywhere.
# Get a free key at https://aistudio.google.com/apikey - no credit card required.
# When this is set, it's used automatically instead of Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local dev fallback - used only when GEMINI_API_KEY is not set.
# Defaults shown below match a default local Ollama install (`ollama serve`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
